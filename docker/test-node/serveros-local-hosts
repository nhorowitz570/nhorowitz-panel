#!/bin/sh
# Points the local ServerOS panel and gateway at the Docker host (Herd).
# Docker rewrites /etc/hosts on every start, so this runs at boot.
# Prefer IPv4: Herd only listens there, and Docker Desktop lists IPv6 first.
ip=$(getent ahostsv4 host.docker.internal | awk 'NR == 1 { print $1 }')
[ -n "$ip" ] || ip=$(getent hosts host.docker.internal | cut -d" " -f1)
[ -n "$ip" ] || exit 0
sed -i "/serveros\.test/d" /etc/hosts
printf "%s serveros.test gateway.serveros.test\n" "$ip" >> /etc/hosts
