APP_NAME=ServerOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DOMAIN=localhost
# DAEMON_CA_CERT=/secure/path/daemon-ca.crt
# DAEMON_INSTALL_READY=true
# DAEMON_CA_KEY=/secure/path/daemon-ca.key
# DAEMON_GATEWAY_HOST=gateway.example.com
# DAEMON_GATEWAY_SECRET=generate-a-long-random-secret
# DAEMON_COMMANDS_ENABLED=false
# DAEMON_GATEWAY_INTERNAL_URL=http://127.0.0.1:8090
# DAEMON_INSTALL_URL=https://panel.example.com/install.sh
# DAEMON_RELEASES_URL=https://releases.serveros.com
# DAEMON_PANEL_URL=https://panel.example.com
# DAEMON_LOCAL_NODE_PORT=8088

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email: log writes it to the log instead of sending it; smtp sends it
# through the server below.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sentry: errors only, no replays, no personal data. Empty means off.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_DSN=
# Source maps, uploaded at build time: all four, or none.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_URL=https://sentry.io/

# Which edition this is. self-hosted, the default, is your own install:
# every workspace gets the free edition, with no trial or billing.
# serveros.com sets cloud, where each workspace's plan decides.
# SERVEROS_EDITION=self-hosted

# Who can make an account on a self-hosted install once it has one. closed,
# the default, means only people invited to a workspace. open lets anyone
# who can reach the panel sign up. serveros.com is always open.
# SERVEROS_SIGN_UPS=closed

# Self-hosted installs send serveros.com an anonymous ping once a day: a
# random install id, the version, whether it's licensed and a few counts.
# serveros.com itself never sends it. See "What your install sends" in
# docs/self-hosting.md; false turns it off.
# SERVEROS_TELEMETRY=true
# SERVEROS_TELEMETRY_URL=https://serveros.com/api/installs/ping

# The assistant's AI, through Groq: an API key, and the model if not the default.
GROQ_API_KEY=
GROQ_MODEL=
