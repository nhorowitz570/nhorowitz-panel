<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The whole suite in one process (as CI runs it) outgrows PHP's default 128M. -->
        <ini name="memory_limit" value="512M"/>
        <!-- testing also makes Laravel read .env.testing instead of .env, so a local .env never reaches the suite. -->
        <env name="APP_ENV" value="testing"/>
        <!-- Links in tests are https on the default port, whatever a local .env (or a fresh copy of .env.example) says. -->
        <env name="APP_URL" value="https://serveros.test"/>
        <env name="APP_DOMAIN" value="serveros.test"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <!-- No SSR server in tests: marketing pages render client-side. -->
        <env name="INERTIA_SSR_ENABLED" value="false"/>
        <!-- Tests set what they need; a local .env must not decide. -->
        <env name="DAEMON_INSTALL_READY" value="false"/>
        <!-- Off unless a test turns it on, so a local .env can't make tests pass that fail in CI. -->
        <env name="DAEMON_COMMANDS_ENABLED" value="false"/>
        <env name="DAEMON_GATEWAY_INTERNAL_URL" value=""/>
        <env name="DAEMON_GATEWAY_SECRET" value=""/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="SENTRY_LARAVEL_DSN" value=""/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <!-- The suite runs as the cloud edition; the self-hosted tests switch to it themselves. -->
        <env name="SERVEROS_EDITION" value="cloud"/>
        <env name="SERVEROS_COMING_SOON" value="false"/>
        <env name="SERVEROS_ADMIN_EMAILS" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="GROQ_API_KEY" value=""/>
        <env name="GROQ_TRANSLATE_KEY" value=""/>
    </php>
</phpunit>
